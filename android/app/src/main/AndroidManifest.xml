    <activity-alias android:name=".IconTealLight" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_teal_light" android:roundIcon="@mipmap/ic_launcher_teal_light" android:targetActivity=".MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <activity-alias android:name=".IconRoseDark" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_rose_dark" android:roundIcon="@mipmap/ic_launcher_rose_dark" android:targetActivity=".MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <activity-alias android:name=".IconRoseLight" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_rose_light" android:roundIcon="@mipmap/ic_launcher_rose_light" android:targetActivity=".MainActivity">
