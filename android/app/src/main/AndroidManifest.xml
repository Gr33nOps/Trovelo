    </activity-alias>
    <activity-alias android:name=".IconPurpleDark" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_purple_dark" android:roundIcon="@mipmap/ic_launcher_purple_dark" android:targetActivity=".MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
