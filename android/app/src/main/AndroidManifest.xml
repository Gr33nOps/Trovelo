    <activity-alias android:name=".IconTealDark" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_teal_dark" android:roundIcon="@mipmap/ic_launcher_teal_dark" android:targetActivity=".MainActivity">
      <intent-filter>
