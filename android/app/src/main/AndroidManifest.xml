    </activity-alias>
    <activity-alias android:name=".IconPurpleLight" android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_purple_light" android:roundIcon="@mipmap/ic_launcher_purple_light" android:targetActivity=".MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
